{# ============================================================ #}
{# ACME Investments – Arista EOS Configuration Template        #}
{# Roles: spine | leaf | border_leaf                           #}
{# Protocols: eBGP Underlay + BGP EVPN Overlay + VXLAN/MLAG   #}
{# ============================================================ #}
! ============================================================
! Generated by: Network as Code – ACME Investments
! Device     : {{ node.hostname }}
! Role       : {{ node.role }}
! Platform   : Arista EOS
! Rendered   : {{ ansible_facts['date_time']['iso8601'] }}
! ============================================================

! --- Hostname ---
hostname {{ node.hostname }}

! --- Global Settings ---
spanning-tree mode mstp
spanning-tree mst 0 priority 4096
service unsupported-transceiver ACME
ip routing
ipv6 unicast-routing
hardware speed-group 1/1 serdes 10g

! --- VRF Definitions ---
{% for vrf in vrfs %}
vrf instance {{ vrf.name }}
   rd {{ vrf.rd_base }}
!
{% endfor %}
ip routing vrf VRF_CORPORATE
ip routing vrf VRF_TRADING
ip routing vrf VRF_DMZ

! --- Loopback Interfaces ---
interface Loopback0
   description "Router-ID / BGP Update Source"
   ip address {{ node.loopback0 }}
!
{% if node.role == 'leaf' or node.role == 'border_leaf' %}
interface Loopback1
   description "VTEP Source – VXLAN"
   ip address {{ node.loopback1 }}
!
{% endif %}

! --- Physical Interfaces ---
{% for intf in node.interfaces %}
interface {{ intf.name }}
   description "{{ intf.description }}"
   {% if intf.mtu is defined %}
   mtu {{ intf.mtu }}
   {% endif %}
   {% if intf.ip is defined %}
   ip address {{ intf.ip }}
   {% endif %}
   no shutdown
!
{% endfor %}

{% if node.role == 'leaf' or node.role == 'border_leaf' %}
! --- MLAG Configuration ---
{% if node.mlag is defined %}
interface Port-Channel1
   description "MLAG Peer-Link >> {{ node.mlag.peer_link }}"
   switchport mode trunk
   switchport trunk allowed vlan all
   mlag 1
!
{% for member in node.mlag.peer_link_members %}
interface {{ member }}
   description "MLAG Peer-Link Member"
   channel-group 1 mode active
   no shutdown
!
{% endfor %}
interface Vlan4094
   description "MLAG Peer-Link L3 Keepalive"
   ip address {{ node.mlag.peer_address }}
   no autostate
!
mlag configuration
   domain-id {{ node.mlag.domain_id }}
   local-interface Vlan4094
   peer-address {{ node.mlag.peer_address | ansible.utils.ipaddr('peer') }}
   peer-link Port-Channel1
   priority {{ node.mlag.priority }}
   reload-delay mlag 360
   reload-delay non-mlag 300
!
{% endif %}

! --- VLAN Database ---
{% for vlan in vlans %}
{% if vlan.id in node.vlans_present %}
vlan {{ vlan.id }}
   name {{ vlan.name }}
!
{% endif %}
{% endfor %}

! --- VXLAN Interface ---
interface Vxlan1
   description "VXLAN Tunnel Interface"
   vxlan source-interface Loopback1
   vxlan udp-port {{ fabric.vxlan_udp_port }}
   vxlan learn-restrict any
{% for vlan in vlans %}
{% if vlan.id in node.vlans_present %}
   vxlan vlan {{ vlan.id }} vni {{ vlan.vni }}
{% endif %}
{% endfor %}
{% for vrf in vrfs %}
   vxlan vrf {{ vrf.name }} vni {{ vrf.l3vni }}
{% endfor %}
!

! --- SVI / IRB Interfaces ---
{% for vlan in vlans %}
{% if vlan.id in node.vlans_present %}
interface Vlan{{ vlan.id }}
   description "{{ vlan.description }}"
   vrf {{ vlan.vrf }}
   ip address virtual {{ vlan.svi_ip_dc }}
   {% if vlan.dhcp_helper is not none %}
   ip helper-address {{ vlan.dhcp_helper }}
   {% endif %}
   no shutdown
!
{% endif %}
{% endfor %}
{% endif %}{# end leaf/border_leaf block #}

! --- BGP Configuration ---
router bgp {{ node.bgp_asn }}
   router-id {{ node.loopback0 | ansible.utils.ipaddr('address') }}
   no bgp default ipv4-unicast
   distance bgp 20 200 200
   graceful-restart restart-time 300
   graceful-restart

   ! Underlay peer-groups
   neighbor UNDERLAY-SPINE peer group
   neighbor UNDERLAY-SPINE bfd
   neighbor UNDERLAY-SPINE send-community
   neighbor UNDERLAY-SPINE maximum-routes 12000

   neighbor UNDERLAY-LEAF peer group
   neighbor UNDERLAY-LEAF bfd
   neighbor UNDERLAY-LEAF send-community
   neighbor UNDERLAY-LEAF maximum-routes 12000

   ! EVPN overlay peer-group
   neighbor OVERLAY-EVPN peer group
   neighbor OVERLAY-EVPN update-source Loopback0
   neighbor OVERLAY-EVPN bfd
   neighbor OVERLAY-EVPN ebgp-multihop 3
   neighbor OVERLAY-EVPN send-community extended

   ! BGP peer statements
{% for peer in node.bgp_peers %}
   neighbor {{ peer.peer_ip }} peer group {% if peer.evpn is defined and peer.evpn %}OVERLAY-EVPN{% else %}UNDERLAY-SPINE{% endif %}

   neighbor {{ peer.peer_ip }} remote-as {{ peer.remote_asn }}
   neighbor {{ peer.peer_ip }} description "{{ peer.description }}"
{% endfor %}

   ! IPv4 Unicast (underlay)
   address-family ipv4
      neighbor UNDERLAY-SPINE activate
      neighbor UNDERLAY-LEAF activate
      network {{ node.loopback0 }}
      {% if node.loopback1 is defined %}
      network {{ node.loopback1 }}
      {% endif %}
   !

   ! EVPN (overlay)
   address-family evpn
      neighbor OVERLAY-EVPN activate
   !

{% if node.role == 'leaf' or node.role == 'border_leaf' %}
   ! Per-VRF address families
{% for vrf in vrfs %}
   vrf {{ vrf.name }}
      rd {{ vrf.rd_base }}
      route-target import evpn {{ vrf.rt_import | join(',') }}
      route-target export evpn {{ vrf.rt_export | join(',') }}
      redistribute connected
   !
{% endfor %}
{% endif %}
!

! --- Management ---
management api http-commands
   protocol https
   no shutdown
!
management ssh
   idle-timeout 10
!
aaa authentication login default group radius local
aaa authorization exec default group radius local
username netadmin privilege 15 secret 9 {{ vault_arista_password }}

! --- NTP & Logging ---
ntp server 10.100.2.100 prefer
ntp server 10.100.2.101
logging host 10.253.2.10 514
logging format timestamp traditional timezone
logging level informational

! --- SNMP ---
snmp-server community ACME-RO ro ACME_SNMP_ACL
snmp-server host 10.253.2.11 version 2c ACME-RO
snmp-server location "ACME Investments – Core DC – {{ node.role | upper }}"
snmp-server contact "NOC – noc@acme-investments.com"

end
