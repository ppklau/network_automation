{# ============================================================ #}
{# ACME Investments – Cisco IOS Configuration Template         #}
{# Roles: branch_router | branch_switch                        #}
{# Protocols: OSPF, 802.1Q Trunking, Extended ACLs            #}
{# ============================================================ #}
! ============================================================
! Generated by: Network as Code – ACME Investments
! Device     : {{ node.hostname }}
! Role       : {{ node.role }}
! Platform   : Cisco IOS
! Rendered   : {{ ansible_facts['date_time']['iso8601'] }}
! ============================================================
version 15.7
service timestamps debug datetime msec localtime show-timezone
service timestamps log datetime msec localtime show-timezone
service password-encryption
no service pad
!
hostname {{ node.hostname }}
!
boot-start-marker
boot-end-marker
!
! --- AAA ---
aaa new-model
aaa authentication login default local
aaa authorization exec default local
!
username netadmin privilege 15 secret 9 {{ vault_cisco_password }}
!
! --- Global IP settings ---
ip routing
ip cef
ip classless
ip tcp adjust-mss 1452
no ip http server
no ip http secure-server
no ip domain lookup
ip domain name acme-investments.internal
ip name-server 10.100.2.50
ip name-server 10.100.2.51
!
{% if node.role == 'branch_router' %}
! ─────────────────────────────────────────────
! BRANCH ROUTER SPECIFIC CONFIGURATION
! ─────────────────────────────────────────────

! --- Access Control Lists ---
{% for acl in node.acls %}
!
! ACL: {{ acl.name }} – {{ acl.description }}
ip access-list {{ acl.type }} {{ acl.name }}
{% for rule in acl.rules %}
 {{ rule }}
{% endfor %}
!
{% endfor %}

! --- Interfaces ---
{% for intf in node.interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
 {% if intf.ip is defined and intf.mode is not defined %}
 ip address {{ intf.ip | ansible.utils.ipaddr('address') }} {{ intf.ip | ansible.utils.ipaddr('netmask') }}
 {% endif %}
 {% if intf.encapsulation_dot1q is defined %}
 encapsulation dot1Q {{ intf.encapsulation_dot1q }}
 ip address {{ intf.ip | ansible.utils.ipaddr('address') }} {{ intf.ip | ansible.utils.ipaddr('netmask') }}
 {% endif %}
 {% if intf.zone == 'wan' %}
 ip access-group ACL_WAN_IN in
 ip nat outside
 {% endif %}
 {% if intf.zone == 'trading' %}
 ip access-group ACL_TRADING_IN in
 {% endif %}
 {% if intf.zone == 'dmz' %}
 ip access-group ACL_DMZ_IN in
 {% endif %}
 {% if intf.mode is defined and intf.mode == 'trunk' and intf.encapsulation_dot1q is not defined %}
 no ip address
 {% endif %}
 no shutdown
!
{% endfor %}

! --- OSPF ---
router ospf {{ node.ospf_process }}
 router-id {{ node.interfaces | selectattr('name', 'equalto', 'Loopback0') | map(attribute='ip') | first | ansible.utils.ipaddr('address') }}
 passive-interface default
 no passive-interface GigabitEthernet0/1
 network 10.10.0.1 0.0.0.0 area {{ node.ospf_area }}
 network 10.10.100.0 0.0.0.255 area {{ node.ospf_area }}
 network 10.10.200.0 0.0.0.255 area {{ node.ospf_area }}
 network 10.10.253.0 0.0.0.255 area {{ node.ospf_area }}
 area {{ node.ospf_area }} authentication message-digest
 default-information originate always
!

! --- Static Default Route (WAN) ---
ip route 0.0.0.0 0.0.0.0 {{ node.wan_gateway }} name WAN_DEFAULT
!

{% endif %}{# end branch_router #}

{% if node.role == 'branch_switch' %}
! ─────────────────────────────────────────────
! BRANCH SWITCH SPECIFIC CONFIGURATION
! ─────────────────────────────────────────────

! --- Spanning Tree ---
spanning-tree mode rapid-pvst
spanning-tree extend system-id
{% for vlan in node.vlans %}
spanning-tree vlan {{ vlan.id }} priority 24576
{% endfor %}
!

! --- VLAN Database ---
{% for vlan in node.vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
!
{% endfor %}

! --- Interfaces ---
{% for intf in node.interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
 {% if intf.mode == 'trunk' %}
 switchport trunk encapsulation dot1q
 switchport trunk native vlan {{ intf.native_vlan }}
 switchport trunk allowed vlan {{ intf.allowed_vlans }}
 switchport mode trunk
 spanning-tree portfast trunk
 {% elif intf.mode == 'access' %}
 switchport mode access
 switchport access vlan {{ intf.vlan }}
 spanning-tree portfast
 spanning-tree bpduguard enable
 storm-control broadcast level 20
 {% elif 'Vlan' in intf.name %}
 ip address {{ intf.ip | ansible.utils.ipaddr('address') }} {{ intf.ip | ansible.utils.ipaddr('netmask') }}
 ip default-gateway {{ intf.gateway }}
 {% endif %}
 no shutdown
!
{% endfor %}

! --- OSPF ---
router ospf {{ node.ospf_process }}
 router-id {{ node.interfaces | selectattr('name', 'equalto', 'Loopback0') | map(attribute='ip') | first | ansible.utils.ipaddr('address') if (node.interfaces | selectattr('name', 'equalto', 'Loopback0') | list | length > 0) else '10.10.0.2' }}
 passive-interface default
 no passive-interface GigabitEthernet0/1
 network 10.10.100.0 0.0.0.255 area {{ node.ospf_area }}
 network 10.10.200.0 0.0.0.255 area {{ node.ospf_area }}
 area {{ node.ospf_area }} authentication message-digest
!

{% endif %}{# end branch_switch #}

! --- NTP ---
ntp server 10.100.2.100 prefer
ntp server 10.100.2.101
clock timezone GMT 0
!
! --- Logging ---
logging buffered 65536 informational
logging trap informational
logging host 10.253.2.10
logging source-interface Loopback0
!
! --- SNMP ---
snmp-server community ACME-RO RO
snmp-server location "ACME Investments – London Branch – {{ node.role | upper }}"
snmp-server contact "NOC – noc@acme-investments.com"
snmp-server host 10.253.2.11 version 2c ACME-RO
!
! --- SSH / VTY ---
crypto key generate rsa modulus 4096
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
!
line con 0
 logging synchronous
 exec-timeout 5 0
!
line vty 0 15
 exec-timeout 10 0
 transport input ssh
 logging synchronous
!
end
